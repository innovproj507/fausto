{
    "name": "ecommerce/core",
    "description": "Sistema Ecommerce Modular en PHP - Sin Frameworks",
    "type": "project",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "vlucas/phpdotenv": "^5.5",
        "firebase/php-jwt": "^6.8",
        "phpmailer/phpmailer": "^6.8",
        "monolog/monolog": "^3.4",
        "guzzlehttp/guzzle": "^7.7",
        "league/flysystem": "^3.15",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2",
        "fakerphp/faker": "^1.23",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "app/Core/",
            "App\\Domain\\": "app/Domain/",
            "App\\Infrastructure\\": "app/Infrastructure/",
            "App\\Api\\": "app/Api/",
            "App\\Services\\": "app/Services/",
            "App\\Contracts\\": "app/Contracts/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse app tests --level=5",
        "serve": "php -S localhost:8000 -t public",
        "migrate": "php cli/migrate.php",
        "seed": "php cli/seed.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}