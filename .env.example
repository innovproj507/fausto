# ===========================================
# ENVIRONMENT CONFIGURATION
# ===========================================

# Application
APP_NAME="Ecommerce System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/New_York

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Security
APP_KEY=base64:YOUR_32_BYTE_KEY_HERE_GENERATE_NEW_ONE
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE_GENERATE_NEW_ONE
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800
CSRF_TOKEN_EXPIRATION=7200

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE=false
SESSION_HTTPONLY=true

# Cache
CACHE_DRIVER=file
CACHE_PREFIX=ecommerce_

# Email
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ecommerce.com
MAIL_FROM_NAME="${APP_NAME}"

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=storage/uploads

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=daily
LOG_PATH=storage/logs

# API
API_VERSION=v1
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=3600

# ERP Integration
ERP_API_URL=https://erp.example.com/api
ERP_API_KEY=
ERP_API_SECRET=
ERP_SYNC_ENABLED=false
ERP_SYNC_INTERVAL=300

# Payment Gateways
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Multi-Store
MULTI_STORE_ENABLED=false
DEFAULT_STORE_CODE=main

# Multi-Currency
MULTI_CURRENCY_ENABLED=false
DEFAULT_CURRENCY=USD
EXCHANGE_RATE_API_KEY=

# Multi-Language
MULTI_LANGUAGE_ENABLED=false
DEFAULT_LANGUAGE=es
AVAILABLE_LANGUAGES=es,en,fr

# Features
ENABLE_REVIEWS=true
ENABLE_WISHLIST=true
ENABLE_COUPONS=true
ENABLE_TWO_FACTOR=false
ENABLE_CHATBOT=false

# Plugins
PLUGINS_ENABLED=true
PLUGINS_PATH=plugins
